{
  "name": "mtg-lore-codex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "MTG Lore Codex — encyklopedia lore prywatnej kolekcji MtG (Karty Katalogowe, hasła, mapy planów)",
  "scripts": {
    "test": "node tools/run-tests.mjs fast",
    "test:slow": "node tools/run-tests.mjs slow",
    "test:all": "node tools/run-tests.mjs all",
    "test:ci": "node tools/run-tests.mjs all",
    "build": "node tools/build.mjs",
    "stats": "node tools/wiki-stats.mjs",
    "stats:json": "node tools/wiki-stats.mjs --json",
    "serve": "node tools/build.mjs && python3 -m http.server --directory dist 3000",
    "dev": "node tools/build.mjs && python3 -m http.server --directory dist 3000",
    "start": "node tools/build.mjs && python3 -m http.server --directory dist 3000"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0"
  }
}
